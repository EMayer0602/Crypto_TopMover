# Binance LIVE API Keys (für echtes Trading)
# Erstelle deine Keys hier: https://www.binance.com/en/my/settings/api-management
BINANCE_API_KEY=dein_api_key_hier
BINANCE_API_SECRET=dein_api_secret_hier

# Binance TESTNET API Keys (Spielgeld - zum Testen!)
# Futures Testnet: https://testnet.binancefuture.com
# Spot Testnet: https://testnet.binance.vision
TESTNET_API_KEY=dein_testnet_api_key
TESTNET_API_SECRET=dein_testnet_api_secret
